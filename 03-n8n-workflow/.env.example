# ─── Alba Market Pulse — environment placeholders ───────────────────────────
# These are EXAMPLES only. Never put real values here.
# Real values go into n8n's Credential store (see docs/SETUP_GUIDE.md).

# The email address the daily digest is sent to.
# Set this inside the Config node in n8n, not here.
DIGEST_RECIPIENT=your-email@example.com

# Google Sheet ID (from the URL: .../spreadsheets/d/<ID>/edit)
# Set this inside the Config node in n8n, not here.
HISTORY_SHEET_ID=your-sheet-id-here

# Gemini API key — NEVER commit a real key.
# Stored in n8n as a Header Auth credential named "Gemini API Key".
# Field name: x-goog-api-key
GEMINI_API_KEY=AIzaYOUR_KEY_HERE

# Gmail and Google Sheets OAuth credentials are configured inside
# n8n Cloud's credential store — no env var needed.
